# Opcional: chaves padrão do SERVIDOR (se vazias, cada usuário traz a sua pela interface).
# Deixe vazio em instâncias públicas para ninguém gastar a sua cota.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOOOSE_DEFAULT_PROVIDER=openrouter
MOOOSE_RATE_LIMIT_PER_MIN=20
# Só ligue se a instância for privada (evita SSRF em servidores públicos):
# MOOOSE_ALLOW_CUSTOM_BASE_URL=1
# Tracing opcional com LangSmith:
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
